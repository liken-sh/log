{{- /* The site's one feed, Atom (RFC 4287), served at /atom.xml.
Each entry carries the whole post as escaped HTML, so a feed reader
shows the post without a visit. The feed's updated stamp is the
newest post's date, and each entry's id is its permalink, which
never changes because a post's URL is its date and slug. Hugo
escapes a literal declaration in an HTML-classed template, so it
goes through safeHTML. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ .Site.Title }}</title>
  <id>{{ .Permalink }}</id>
  <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
  <link href="{{ (.OutputFormats.Get "atom").Permalink }}" rel="self" type="application/atom+xml"/>
  {{- with site.RegularPages.ByDate.Reverse }}
  <updated>{{ (index . 0).Date.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- end }}
  <author><name>{{ site.Params.author }}</name></author>
  {{- range site.RegularPages.ByDate.Reverse }}
  <entry>
    <title>{{ .Title }}</title>
    <id>{{ .Permalink }}</id>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    {{- /* A backfilled post's updated stamp is the day it was
    written, so readers who sort by update see it arrive when it
    actually did. */}}
    {{- with .Params.backfilled }}
    <updated>{{ (time.AsTime .).Format "2006-01-02T15:04:05Z07:00" }}</updated>
    {{- else }}
    <updated>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    {{- end }}
    <content type="html">{{ .Content | html }}</content>
  </entry>
  {{- end }}
</feed>
